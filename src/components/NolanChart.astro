---
interface Props {
  eco: number
  pers: number
  class?: string
}

const { eco, pers, class: className = 'w-24 h-24 drop-shadow-sm' } = Astro.props

const x = (eco - pers + 4) * 12.5
const y = 100 - (eco + pers - 2) * 12.5
---

<svg
  viewBox="0 0 100 100"
  class={className}
  role="img"
  aria-label={`Gráfico de Nolan: Económica ${eco}, Personal ${pers}`}
  data-eco={eco}
  data-pers={pers}
>
  <polygon points="50,0 75,25 50,50 25,25" fill="#22c55e" />
  <polygon points="0,50 25,25 50,50 25,75" fill="#ef4444" />
  <polygon points="100,50 75,25 50,50 75,75" fill="#3b82f6" />
  <polygon points="50,100 75,75 50,50 25,75" fill="#ffff00" />
  <polygon points="50,35 65,50 50,65 35,50" fill="white" stroke="black" stroke-width="0.5" />
  <polygon points="50,0 100,50 50,100 0,50" fill="none" stroke="black" stroke-width="1" />
  <circle class="nolan-dot" cx={x} cy={y} r="4" fill="black" />
</svg>
