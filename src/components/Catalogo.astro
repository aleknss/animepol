---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { ListFilter } from '@lucide/astro'
import AnimeList from '@/components/anime/AnimeList.astro'
import Creditos from '@/components/Creditos.astro'
import DiscordIcon from '@/components/DiscordIcon.astro'
import NolanChart from '@/components/NolanChart.astro'
import SearchBar from '@/components/search/SearchBar.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { DISCORD_INVITE, IDEOLOGIAS, IDEO_COLORS, partidosActivos } from '@/lib/utils'

interface Props {
  animes: CollectionEntry<'animes'>[]
  generos: CollectionEntry<'generos'>[]
}

const { animes, generos } = Astro.props
const partidos = partidosActivos()
  ? (await getCollection('partidos')).sort((a, b) => a.data.orden - b.data.orden)
  : []
---

<div class="min-h-screen bg-background py-6 px-4">
  <header class="top-6 max-w-6xl m-auto flex justify-between items-center">
    <Creditos />
    <ThemeToggle />
  </header>

  <main class="text-center mb-10">
    <img src="/kanji.svg" alt="Animepol" width="100" height="100" class="mx-auto mb-4 h-40 w-auto" />
    <h1 class="text-4xl font-extrabold text-primary mb-4 tracking-tighter">Animepol</h1>
    <p class="text-foreground ">
      ¿Cuál es tu alineamiento político según tu anime favorito?
      <span class="text-muted-foreground ml-1">#humor</span>
    </p>

    <div class="flex justify-center gap-8 items-center">
      <a
        href="/diagrama-nolan"
        class="my-4 inline-block transition-transform hover:scale-110"
        aria-label="Diagrama de Nolan"
      >
        <NolanChart eco={3} pers={3} class="w-24 h-24 drop-shadow-sm" />
      </a>
      <a
        href={DISCORD_INVITE}
        target="_blank"
        rel="noopener noreferrer"
        class="my-4 inline-flex flex-col items-center gap-1 transition-transform hover:scale-110"
        aria-label="Participa en el Discord de Animepol"
      >
        <DiscordIcon class="size-16 text-[#5865F2] drop-shadow-sm" />
        <span class="text-base font-black text-[#5865F2]">
          Participa
        </span>
      </a>
    </div>
  </main>

  <SearchBar />

  {
    partidos.length > 0 && (
      <div class="max-w-6xl mx-auto mb-4">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
          {partidos.map((partido) => (
            <button
              type="button"
              data-filter-partido={partido.id}
              aria-pressed="false"
              class="inline-flex h-11 items-center justify-center rounded-xl px-3 text-xs font-black uppercase tracking-wide text-white transition-transform hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-offset-2 aria-pressed:ring-offset-background"
              style={`background-color:${partido.data.color};--tw-ring-color:${partido.data.color}`}
            >
              {partido.data.siglas}
            </button>
          ))}
        </div>
        <a
          href="/partidos"
          class="mt-2 inline-block text-[11px] text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          Ver el reparto completo
        </a>
      </div>
    )
  }

  <div class="max-w-6xl mx-auto mb-6 flex items-center gap-2">
    <button
      id="toggle-filters"
      type="button"
      aria-expanded="false"
      aria-controls="filters-panel"
      class="inline-flex h-8 items-center justify-center gap-1.5 rounded-lg border border-border bg-background px-2.5 text-sm font-medium whitespace-nowrap transition-colors hover:bg-muted"
    >
      <ListFilter class="size-4" />
      Filtros
      <span
        id="filters-count"
        class="hidden ml-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-[11px] leading-none text-primary-foreground"
      >
        0
      </span>
    </button>
  </div>

  <div id="filters-panel" hidden class="max-w-6xl mx-auto mb-6 space-y-4">
    <div class="space-y-2">
      <p class="text-xs font-semibold tracking-wide uppercase text-muted-foreground/70">Géneros</p>
      <div class="flex flex-wrap gap-1.5">
        {
          generos.map((genero) => (
            <button
              type="button"
              data-filter-genre={genero.data.nombre}
              aria-pressed="false"
              class="inline-flex h-5 items-center rounded-4xl border border-border px-2 text-xs font-medium whitespace-nowrap transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            >
              {genero.data.nombre}
            </button>
          ))
        }
      </div>
    </div>

    <div class="space-y-2">
      <p class="text-xs font-semibold tracking-wide uppercase text-muted-foreground/70">Ideología</p>
      <div class="flex flex-wrap gap-1.5">
        {
          IDEOLOGIAS.map((ideologia) => (
            <button
              type="button"
              data-filter-ideologia={ideologia}
              aria-pressed="false"
              class:list={[
                'inline-flex items-center rounded-full border border-transparent px-3 py-1 text-xs font-medium opacity-50 transition-all hover:opacity-80 aria-pressed:border-current aria-pressed:opacity-100',
                IDEO_COLORS[ideologia],
              ]}
            >
              {ideologia}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto mb-4 flex items-center gap-2">
    <span id="results-count" class="text-xs text-muted-foreground"></span>
    <button id="clear-filters" type="button" class="hidden text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
      Limpiar filtros
    </button>
  </div>

  <AnimeList animes={animes} />

  <div id="catalogo-empty" hidden class="text-center py-10 text-muted-foreground">
    No hay resultados.
  </div>
</div>

<script>
  import { normalizeSearch, shuffle } from '@/lib/utils'

  const SHUFFLE_KEY = 'animepol-shuffle-v1'
  const SHUFFLE_TTL = 30 * 60 * 1000

  const grid = document.querySelector<HTMLElement>('#anime-grid')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-anime-card]'))
  const searchInput = document.querySelector<HTMLInputElement>('#catalogo-search')
  const clearSearch = document.querySelector<HTMLButtonElement>('#catalogo-search-clear')
  const toggleFilters = document.querySelector<HTMLButtonElement>('#toggle-filters')
  const filtersPanel = document.querySelector<HTMLElement>('#filters-panel')
  const filtersCount = document.querySelector<HTMLElement>('#filters-count')
  const resultsCount = document.querySelector<HTMLElement>('#results-count')
  const clearFilters = document.querySelector<HTMLButtonElement>('#clear-filters')
  const emptyState = document.querySelector<HTMLElement>('#catalogo-empty')
  const genreButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-genre]'))
  const ideologyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-ideologia]'))
  const partidoButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-partido]'))

  const selectedGenres = new Set<string>()
  const selectedIdeologies = new Set<string>()
  const selectedPartidos = new Set<string>()

  function updateFilterCount() {
    const total = selectedGenres.size + selectedIdeologies.size + selectedPartidos.size

    if (filtersCount) {
      filtersCount.textContent = String(total)
      filtersCount.classList.toggle('hidden', total === 0)
    }
  }

  function applyFilters() {
    const query = normalizeSearch(searchInput?.value ?? '')
    const visible = new Set<HTMLElement>()

    for (const card of cards) {
      const matchesSearch = !query || (card.dataset.search ?? '').includes(query)
      const cardGenres = (card.dataset.generos ?? '').split('|').filter(Boolean)
      const matchesGenre = selectedGenres.size === 0 || cardGenres.some((genre) => selectedGenres.has(genre))
      const matchesIdeology =
        selectedIdeologies.size === 0 || selectedIdeologies.has(card.dataset.ideologia ?? '')
      const matchesPartido =
        selectedPartidos.size === 0 || selectedPartidos.has(card.dataset.partido ?? '')

      if (matchesSearch && matchesGenre && matchesIdeology && matchesPartido) {
        visible.add(card)
      }
    }

    for (const card of cards) {
      card.style.display = visible.has(card) ? '' : 'none'
    }

    if (emptyState) emptyState.hidden = visible.size > 0
    if (resultsCount) {
      resultsCount.textContent = `${visible.size} resultado${visible.size === 1 ? '' : 's'}`
    }

    const hasFilters =
      selectedGenres.size > 0 || selectedIdeologies.size > 0 || selectedPartidos.size > 0
    clearFilters?.classList.toggle('hidden', !hasFilters && query.length === 0)
    clearSearch?.classList.toggle('hidden', query.length === 0)
    updateFilterCount()
  }

  function loadShuffle(): string[] | null {
    try {
      const raw = localStorage.getItem(SHUFFLE_KEY)
      if (!raw) return null

      const parsed = JSON.parse(raw) as { ids?: unknown; expiry?: unknown }
      if (!Array.isArray(parsed.ids) || typeof parsed.expiry !== 'number') return null
      if (parsed.expiry < Date.now()) return null

      return parsed.ids.filter((id): id is string => typeof id === 'string')
    } catch {
      return null
    }
  }

  function saveShuffle(ids: string[]) {
    try {
      localStorage.setItem(SHUFFLE_KEY, JSON.stringify({ ids, expiry: Date.now() + SHUFFLE_TTL }))
    } catch {}
  }

  function arraysMatch(a: string[], b: string[]): boolean {
    if (a.length !== b.length) return false

    const sortedA = [...a].sort()
    const sortedB = [...b].sort()
    return sortedA.every((value, index) => value === sortedB[index])
  }

  function applyShuffle() {
    if (!grid || cards.length === 0) return

    const currentIds = cards.map((card) => card.dataset.id ?? '')
    const stored = loadShuffle()
    const order = stored && arraysMatch(stored, currentIds) ? stored : shuffle(currentIds)

    if (!stored || !arraysMatch(stored, currentIds)) saveShuffle(order)

    const byId = new Map(cards.map((card) => [card.dataset.id ?? '', card]))

    for (const id of order) {
      const card = byId.get(id)
      if (card) grid.appendChild(card)
    }
  }

  toggleFilters?.addEventListener('click', () => {
    if (!filtersPanel) return

    const open = filtersPanel.hidden
    filtersPanel.hidden = !open
    toggleFilters.setAttribute('aria-expanded', String(open))
    toggleFilters.classList.toggle('bg-secondary', open)
  })

  for (const button of genreButtons) {
    button.addEventListener('click', () => {
      const genre = button.dataset.filterGenre
      if (!genre) return

      if (selectedGenres.has(genre)) selectedGenres.delete(genre)
      else selectedGenres.add(genre)

      button.setAttribute('aria-pressed', String(selectedGenres.has(genre)))
      applyFilters()
    })
  }

  for (const button of ideologyButtons) {
    button.addEventListener('click', () => {
      const ideologia = button.dataset.filterIdeologia
      if (!ideologia) return

      if (selectedIdeologies.has(ideologia)) selectedIdeologies.delete(ideologia)
      else selectedIdeologies.add(ideologia)

      button.setAttribute('aria-pressed', String(selectedIdeologies.has(ideologia)))
      applyFilters()
    })
  }

  for (const button of partidoButtons) {
    button.addEventListener('click', () => {
      const partido = button.dataset.filterPartido
      if (!partido) return

      if (selectedPartidos.has(partido)) selectedPartidos.delete(partido)
      else selectedPartidos.add(partido)

      button.setAttribute('aria-pressed', String(selectedPartidos.has(partido)))
      applyFilters()
    })
  }

  clearFilters?.addEventListener('click', () => {
    selectedGenres.clear()
    selectedIdeologies.clear()
    selectedPartidos.clear()

    for (const button of genreButtons) button.setAttribute('aria-pressed', 'false')
    for (const button of ideologyButtons) button.setAttribute('aria-pressed', 'false')
    for (const button of partidoButtons) button.setAttribute('aria-pressed', 'false')

    if (searchInput) searchInput.value = ''
    applyFilters()
    searchInput?.focus()
  })

  clearSearch?.addEventListener('click', () => {
    if (searchInput) searchInput.value = ''
    applyFilters()
    searchInput?.focus()
  })

  let searchTimer: number | undefined

  searchInput?.addEventListener('input', () => {
    window.clearTimeout(searchTimer)
    searchTimer = window.setTimeout(applyFilters, 80)
  })

  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault()
      searchInput?.focus()
    }
  })

  applyShuffle()
  applyFilters()
</script>
