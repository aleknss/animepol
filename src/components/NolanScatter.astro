---
interface Punto {
  slug: string
  siglas: string
  nombre: string
  color: string
  eco: number
  pers: number
  total: number
}

interface Props {
  puntos: Punto[]
  activo?: string
  class?: string
}

const { puntos, activo, class: className = 'w-full max-w-md mx-auto' } = Astro.props

const x = (eco: number, pers: number) => (eco - pers + 4) * 12.5
const y = (eco: number, pers: number) => 100 - (eco + pers - 2) * 12.5

// Los puntos se agolpan en el eje horizontal, así que las etiquetas de los que
// tienen vecino se centran encima o debajo para no pisarse.
const puntosResueltos = puntos.map((punto, i) => {
  const px = x(punto.eco, punto.pers)
  const py = y(punto.eco, punto.pers)
  const apretado = puntos.some((otro, j) => {
    if (j === i) return false
    return Math.hypot(x(otro.eco, otro.pers) - px, y(otro.eco, otro.pers) - py) < 12
  })

  if (apretado) {
    return {
      ...punto,
      px,
      py,
      labelX: px,
      labelY: py + (i % 2 === 0 ? -5.5 : 6.5),
      anchor: 'middle' as const,
    }
  }

  const pegadoDerecha = px > 82

  return {
    ...punto,
    px,
    py,
    labelX: pegadoDerecha ? px - 5 : px + 5,
    labelY: py + 1.6,
    anchor: (pegadoDerecha ? 'end' : 'start') as 'end' | 'start',
  }
})
---

<svg
  viewBox="-6 -6 112 112"
  class={className}
  role="img"
  aria-label="Diagrama de Nolan con la posición de cada partido"
>
  <polygon points="50,0 75,25 50,50 25,25" fill="#22c55e" opacity="0.85" />
  <polygon points="0,50 25,25 50,50 25,75" fill="#ef4444" opacity="0.85" />
  <polygon points="100,50 75,25 50,50 75,75" fill="#3b82f6" opacity="0.85" />
  <polygon points="50,100 75,75 50,50 25,75" fill="#ffff00" opacity="0.85" />
  <polygon points="50,0 100,50 50,100 0,50" fill="none" stroke="#000000" stroke-width="0.7" opacity="0.55" />
  <line x1="50" y1="0" x2="50" y2="100" stroke="#000000" stroke-width="0.4" opacity="0.25" />
  <line x1="0" y1="50" x2="100" y2="50" stroke="#000000" stroke-width="0.4" opacity="0.25" />

  {
    puntosResueltos.map((punto) => {
      const activoEste = !activo || activo === punto.slug
      return (
        <g opacity={activoEste ? 1 : 0.3}>
          <circle
            cx={punto.px}
            cy={punto.py}
            r={activo && activo === punto.slug ? 4.6 : 3.4}
            fill={punto.color}
            stroke="#000000"
            stroke-width="0.9"
          >
            <title>{`${punto.nombre}: económica ${punto.eco.toFixed(1)}, personal ${punto.pers.toFixed(1)} (${punto.total} animes)`}</title>
          </circle>
          <text
            x={punto.labelX}
            y={punto.labelY}
            text-anchor={punto.anchor}
            font-size="3.4"
            font-weight="800"
            fill="#000000"
          >
            {punto.siglas}
          </text>
        </g>
      )
    })
  }
</svg>
