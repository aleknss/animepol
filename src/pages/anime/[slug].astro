---
import { getCollection, type CollectionEntry } from 'astro:content'
import { ArrowLeft, TriangleAlert } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import DiscordIcon from '@/components/DiscordIcon.astro'
import NolanChart from '@/components/NolanChart.astro'
import Spoiler from '@/components/Spoiler.astro'
import { parseSpoilers, stripSpoilers } from '@/lib/spoilers'
import { DISCORD_INVITE, partidosActivos, textoSobreColor } from '@/lib/utils'

export async function getStaticPaths() {
  const animes = await getCollection('animes')

  return animes.map((anime) => ({
    params: { slug: anime.data.slug },
    props: { anime },
  }))
}

interface Props {
  anime: CollectionEntry<'animes'>
}

const { anime } = Astro.props
const { data } = anime
const sinopsisParts = data.sinopsis ? parseSpoilers(data.sinopsis) : []
const analisisParts = data.analisisPolitico ? parseSpoilers(data.analisisPolitico) : []
const description =
  stripSpoilers(data.sinopsis ?? '').slice(0, 160) ||
  `${data.titulo} - Análisis político en el diagrama de Nolan.`
const image = data.imagen ?? '/og-image.webp'
const site = Astro.site ?? new URL('https://www.animepol.xyz')
const pageUrl = new URL(`/anime/${data.slug}`, site).toString()
const partidos = partidosActivos() ? await getCollection('partidos') : []
const partido = data.partido ? partidos.find((item) => item.id === data.partido) : undefined
const relacionados = data.partido
  ? (await getCollection('animes'))
      .filter((item) => item.data.partido === data.partido && item.id !== anime.id)
      .sort(
        (a, b) =>
          Math.abs(a.data.libertadEconomica - data.libertadEconomica) +
          Math.abs(a.data.libertadPersonal - data.libertadPersonal) -
          (Math.abs(b.data.libertadEconomica - data.libertadEconomica) +
            Math.abs(b.data.libertadPersonal - data.libertadPersonal)),
      )
      .slice(0, 3)
  : []

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.titulo,
  description: stripSpoilers(data.sinopsis ?? '').slice(0, 200),
  image: new URL(image, site).toString(),
  datePublished: data.anoLanzamiento ? `${data.anoLanzamiento}` : undefined,
  genre: data.generos.length > 0 ? data.generos : undefined,
  about:
    data.generos.length > 0
      ? data.generos.map((genero) => ({ '@type': 'Thing', name: genero }))
      : undefined,
  url: pageUrl,
  inLanguage: 'es',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Animepol',
    url: site.toString(),
  },
}
---

<Layout
  title={data.titulo}
  description={description}
  type="article"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-background p-6 md:p-12">
    <div class="max-w-7xl mx-auto">
      <a
        href="/"
        class="mt-4 mb-8 inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <ArrowLeft class="size-4" />
        Catálogo
      </a>

      <div class="flex flex-col md:flex-row gap-12">
        <div class="w-full md:w-80 shrink-0">
          <div class="relative aspect-3/4 rounded-2xl overflow-hidden shadow-lg bg-muted border border-border">
            {
              data.imagen ? (
                <img
                  src={data.imagen}
                  alt={data.titulo}
                  fetchpriority="high"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-muted-foreground">
                  Sin póster
                </div>
              )
            }
          </div>

          <div class="mt-8 p-6 bg-muted/50 rounded-2xl border border-border">
            <p class="text-[10px] font-black uppercase tracking-tighter text-muted-foreground mb-4">
              Alineamiento Nolan
            </p>
            <NolanChart
              eco={data.libertadEconomica}
              pers={data.libertadPersonal}
              class="w-24 h-24 mx-auto drop-shadow-sm"
            />
            <div class="flex justify-center gap-6 mt-4 text-xs font-bold">
              <span class="text-foreground">Econ: {data.libertadEconomica}/5</span>
              <span class="text-foreground">Pers: {data.libertadPersonal}/5</span>
            </div>
          </div>

          {
            partido && data.justificacionPartido && (
              <div
                class="mt-6 rounded-2xl border bg-card overflow-hidden"
                style={`border-color:${partido.data.color}`}
              >
                <div
                  class="flex items-center gap-3 px-5 py-3"
                  style={`background-color:${partido.data.color};color:${textoSobreColor(partido.data.color)}`}
                >
                  <span class="text-lg font-black tracking-tighter">{partido.data.siglas}</span>
                  <span class="text-[10px] font-bold uppercase tracking-widest opacity-80">
                    {partido.data.nombre}
                  </span>
                </div>
                <div class="px-5 py-4">
                  <div class="flex items-center gap-3 mb-3">
                    <img
                      src={partido.data.logo}
                      alt={partido.data.nombre}
                      width="52"
                      height="32"
                      loading="lazy"
                      class="h-8 w-auto max-w-16 object-contain dark:brightness-0 dark:invert"
                    />
                    <p class="text-[10px] font-black uppercase tracking-tighter text-muted-foreground">
                      {partido.data.ideologia}
                    </p>
                  </div>
                  <p
                    class="mb-2 inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-muted-foreground"
                  >
                    <TriangleAlert class="size-3" />
                    Contiene spoilers
                  </p>
                  <p class="text-sm leading-relaxed text-foreground/80">
                    {data.justificacionPartido}
                  </p>
                  <a
                    href={`/partidos#${partido.id}`}
                    class="mt-3 inline-block text-[11px] font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground"
                  >
                    Ver todos los partidos
                  </a>
                  <p class="mt-3 border-t border-border pt-3 text-[10px] text-muted-foreground/70">
                    Asignación satírica con motivo del 29N. Sin relación con los partidos.
                  </p>
                </div>
              </div>
            )
          }
        </div>

        <div class="grow">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            {
              data.generos.map((genero) => (
                <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded-full border border-border">
                  {genero}
                </span>
              ))
            }
          </div>

          <h1 class="text-5xl font-black text-foreground mb-6 tracking-tighter">
            {data.titulo}
          </h1>

          <div class="h-px w-full bg-border mb-8"></div>

          <div class="space-y-10">
            <section>
              {
                data.sinopsis ? (
                  <div class="text-muted-foreground leading-relaxed font-medium whitespace-pre-line">
                    {sinopsisParts.map((part) =>
                      part.type === 'spoiler' ? <Spoiler>{part.content}</Spoiler> : part.content,
                    )}
                  </div>
                ) : (
                  <p class="text-muted-foreground italic">Sin sinopsis disponible.</p>
                )
              }
            </section>

            <section>
              <h2 class="text-xl font-black text-foreground mb-4">Análisis</h2>
              {
                data.analisisPolitico ? (
                  <div class="text-lg leading-relaxed text-foreground/80 whitespace-pre-line">
                    {analisisParts.map((part) =>
                      part.type === 'spoiler' ? <Spoiler>{part.content}</Spoiler> : part.content,
                    )}
                  </div>
                ) : (
                  <p class="text-muted-foreground italic">Sin análisis disponible.</p>
                )
              }
            </section>

            <section class="mt-10 border-t border-border pt-6">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm text-muted-foreground">
                  ¿Está mal clasificado, falta un género o la sinopsis destripa algo?
                  <span class="text-foreground">Debátelo en el Discord.</span>
                </p>
                <a
                  href={DISCORD_INVITE}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-bold text-primary transition-colors hover:text-foreground"
                >
                  <DiscordIcon class="size-4" />
                  Debatir en Discord
                </a>
              </div>
            </section>

            {
              partido && relacionados.length > 0 && (
                <section class="mt-10 border-t border-border pt-6">
                  <h2 class="text-xl font-black text-foreground mb-4">
                    Más de {partido.data.siglas}
                  </h2>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    {relacionados.map((item) => (
                      <a
                        href={`/anime/${item.data.slug}`}
                        class="group rounded-xl border border-border bg-card overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-md"
                      >
                        <div class="relative w-full aspect-3/4 bg-muted overflow-hidden">
                          {item.data.imagen && (
                            <img
                              src={item.data.imagen}
                              alt={item.data.titulo}
                              loading="lazy"
                              decoding="async"
                              class="absolute inset-0 h-full w-full object-cover"
                            />
                          )}
                        </div>
                        <p class="px-3 py-2 text-xs font-bold text-card-foreground transition-colors group-hover:text-primary line-clamp-2">
                          {item.data.titulo}
                        </p>
                      </a>
                    ))}
                  </div>
                </section>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
