---
import { getCollection, type CollectionEntry } from 'astro:content'
import { ArrowLeft } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import NolanChart from '@/components/NolanChart.astro'
import Spoiler from '@/components/Spoiler.astro'
import { parseSpoilers, stripSpoilers } from '@/lib/spoilers'

export async function getStaticPaths() {
  const animes = await getCollection('animes')

  return animes.map((anime) => ({
    params: { slug: anime.data.slug },
    props: { anime },
  }))
}

interface Props {
  anime: CollectionEntry<'animes'>
}

const { anime } = Astro.props
const { data } = anime
const sinopsisParts = data.sinopsis ? parseSpoilers(data.sinopsis) : []
const analisisParts = data.analisisPolitico ? parseSpoilers(data.analisisPolitico) : []
const description =
  stripSpoilers(data.sinopsis ?? '').slice(0, 160) ||
  `${data.titulo} - Análisis político en el diagrama de Nolan.`
const image = data.imagen ?? '/og-image.webp'
const site = Astro.site ?? new URL('https://www.animepol.xyz')
const pageUrl = new URL(`/anime/${data.slug}`, site).toString()

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.titulo,
  description: stripSpoilers(data.sinopsis ?? '').slice(0, 200),
  image: new URL(image, site).toString(),
  datePublished: data.anoLanzamiento ? `${data.anoLanzamiento}` : undefined,
  genre: data.generos.length > 0 ? data.generos : undefined,
  about:
    data.generos.length > 0
      ? data.generos.map((genero) => ({ '@type': 'Thing', name: genero }))
      : undefined,
  url: pageUrl,
  inLanguage: 'es',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Animepol',
    url: site.toString(),
  },
}
---

<Layout
  title={data.titulo}
  description={description}
  image={image}
  type="article"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-background p-6 md:p-12">
    <div class="max-w-7xl mx-auto">
      <a
        href="/"
        class="text-muted-foreground hover:text-foreground mb-8 inline-flex items-center gap-1.5 transition-colors font-bold uppercase text-xs tracking-widest"
      >
        <ArrowLeft class="size-4" />
        Catálogo
      </a>

      <div class="flex flex-col md:flex-row gap-12">
        <div class="w-full md:w-80 shrink-0">
          <div class="relative aspect-3/4 rounded-2xl overflow-hidden shadow-lg bg-muted border border-border">
            {
              data.imagen ? (
                <img
                  src={data.imagen}
                  alt={data.titulo}
                  fetchpriority="high"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-muted-foreground">
                  Sin póster
                </div>
              )
            }
          </div>

          <div class="mt-8 p-6 bg-muted/50 rounded-2xl border border-border">
            <p class="text-[10px] font-black uppercase tracking-tighter text-muted-foreground mb-4">
              Alineamiento Nolan
            </p>
            <NolanChart
              eco={data.libertadEconomica}
              pers={data.libertadPersonal}
              class="w-24 h-24 mx-auto drop-shadow-sm"
            />
            <div class="flex justify-center gap-6 mt-4 text-xs font-bold">
              <span class="text-foreground">Econ: {data.libertadEconomica}/5</span>
              <span class="text-foreground">Pers: {data.libertadPersonal}/5</span>
            </div>
          </div>
        </div>

        <div class="grow">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            {
              data.generos.map((genero) => (
                <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded-full border border-border">
                  {genero}
                </span>
              ))
            }
          </div>

          <h1 class="text-5xl font-black text-foreground mb-6 tracking-tighter">
            {data.titulo}
          </h1>

          <div class="h-px w-full bg-border mb-8"></div>

          <div class="space-y-10">
            <section>
              {
                data.sinopsis ? (
                  <div class="text-muted-foreground leading-relaxed font-medium whitespace-pre-line">
                    {sinopsisParts.map((part) =>
                      part.type === 'spoiler' ? <Spoiler>{part.content}</Spoiler> : part.content,
                    )}
                  </div>
                ) : (
                  <p class="text-muted-foreground italic">Sin sinopsis disponible.</p>
                )
              }
            </section>

            <section>
              <h2 class="text-xl font-black text-foreground mb-4">Análisis</h2>
              {
                data.analisisPolitico ? (
                  <div class="text-lg leading-relaxed text-foreground/80 whitespace-pre-line">
                    {analisisParts.map((part) =>
                      part.type === 'spoiler' ? <Spoiler>{part.content}</Spoiler> : part.content,
                    )}
                  </div>
                ) : (
                  <p class="text-muted-foreground italic">Sin análisis disponible.</p>
                )
              }
            </section>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
