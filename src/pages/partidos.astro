---
import { getCollection } from 'astro:content'
import { ArrowLeft, ChevronLeft, ChevronRight } from '@lucide/astro'
import Creditos from '@/components/Creditos.astro'
import NolanScatter from '@/components/NolanScatter.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import Layout from '@/layouts/Layout.astro'
import { partidosActivos, textoSobreColor } from '@/lib/utils'
const partidos = (await getCollection('partidos')).sort((a, b) => a.data.orden - b.data.orden)
const animes = await getCollection('animes')
const activo = partidosActivos()

const porPartido = partidos.map((partido) => ({
  partido,
  animes: animes
    .filter((anime) => anime.data.partido === partido.id)
    .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es')),
}))

const total = porPartido.reduce((sum, item) => sum + item.animes.length, 0)

const media = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length

const puntos = porPartido
  .filter((item) => item.animes.length > 0)
  .map((item) => ({
    slug: item.partido.id,
    siglas: item.partido.data.siglas,
    nombre: item.partido.data.nombre,
    color: item.partido.data.color,
    eco: Math.round(media(item.animes.map((anime) => anime.data.libertadEconomica)) * 10) / 10,
    pers: Math.round(media(item.animes.map((anime) => anime.data.libertadPersonal)) * 10) / 10,
    total: item.animes.length,
  }))

const stats = new Map(puntos.map((punto) => [punto.slug, punto]))
---

<Layout
  title="Partidos del 29N"
  description="Qué partido político le correspondería a cada anime según el diagrama de Nolan. Reparto satírico con motivo de las elecciones generales del 29 de noviembre."
>
  <div class="min-h-screen bg-background py-6 px-4">
    <header class="top-6 max-w-6xl w-full m-auto flex justify-between items-center">
      <Creditos />
      <ThemeToggle />
    </header>

    <main class="max-w-6xl mx-auto">
      <a
        href="/"
        class="text-muted-foreground hover:text-foreground mb-8 inline-flex items-center gap-1.5 transition-colors font-bold uppercase text-xs tracking-widest"
      >
        <ArrowLeft class="size-4" />
        Catálogo
      </a>

      <div class="max-w-6xl mx-auto my-8 border-y-2 border-foreground/80 py-6 text-center">
        <p class="text-[10px] font-black uppercase tracking-[0.35em] text-muted-foreground">
          Elecciones generales · 29 de noviembre
        </p>
        <p
          class="mt-1 text-7xl md:text-8xl font-black tracking-tighter leading-none"
          aria-label="29 de noviembre"
        >
          <span class="text-[#AA151B]">2</span><span class="text-[#F1BF00]">9</span><span class="text-[#AA151B]">N</span>
        </p>
        <p class="mt-3 text-xs font-black uppercase tracking-widest text-foreground">
          Sátira electoral, no una encuesta
        </p>
      </div>

      <div class="mb-10 text-center">
        <h1 class="text-4xl md:text-5xl font-black text-primary tracking-tighter mb-3">
          ¿A quién votaría tu anime?
        </h1>
        <p class="text-foreground max-w-2xl mx-auto">
          {total} fichas repartidas entre seis partidos, con el mismo rigor que el resto del sitio:
          ninguno. Esto es una asignación satírica, no una encuesta ni una recomendación de voto.
        </p>
        {
          !activo && (
            <p class="mt-4 inline-block rounded-full border border-border px-3 py-1 text-xs font-bold uppercase tracking-widest text-muted-foreground">
              Evento finalizado
            </p>
          )
        }
      </div>

      <div class="mb-10 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start">
        <section aria-labelledby="scatter-titulo">
          <h2 id="scatter-titulo" class="text-xl font-black text-foreground tracking-tighter">
            Dónde cae cada partido
          </h2>
          <p class="text-xs text-muted-foreground">
            Media de los ejes de sus animes. El eje vertical es libertad personal; el horizontal,
            económica.
          </p>

          <NolanScatter puntos={puntos} class="mt-4 w-full max-w-md mx-auto" />

          <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {
              puntos.map((punto) => (
                <li class="flex items-center gap-2 text-[11px]">
                  <span
                    class="size-2.5 shrink-0 rounded-full"
                    style={`background-color:${punto.color}`}
                    aria-hidden="true"
                  />
                  <span class="font-black uppercase tracking-wide text-foreground">
                    {punto.siglas}
                  </span>
                  <span class="text-muted-foreground">
                    Econ {punto.eco.toFixed(1)} · Pers {punto.pers.toFixed(1)}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="quiz-titulo" class="lg:border-l lg:border-border lg:pl-10">
          <p class="text-[10px] font-black uppercase tracking-[0.3em] text-muted-foreground">
            Test rápido
          </p>
          <h2
            id="quiz-titulo"
            class="mt-1 text-3xl md:text-4xl font-black tracking-tighter text-primary"
          >
            ¡Haz el quiz!
          </h2>
          <p class="mt-3 max-w-sm text-sm text-foreground/80">
            Diez animes al azar. Elige partido, mira la justificación y comprueba cuánto has
            interiorizado del reparto. Sin registro y con récord guardado en tu navegador.
          </p>

          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[11px] font-bold uppercase tracking-widest text-muted-foreground">
            <li>10 preguntas</li>
            <li>1 minuto</li>
            <li>Sin registro</li>
          </ul>

          <a
            href="/partidos/quiz"
            class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-black uppercase tracking-widest text-primary-foreground transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
          >
            Jugar ahora
            <span aria-hidden="true">→</span>
          </a>

          <p class="mt-3 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
            Disponible hasta el 13 de diciembre
          </p>
        </section>
      </div>

      <div class="mb-2 flex items-stretch gap-2">
        <button
          type="button"
          data-party-prev
          aria-label="Partido anterior"
          class="inline-flex h-20 w-10 shrink-0 items-center justify-center rounded-xl border border-border bg-card text-foreground transition-colors hover:bg-muted hover:text-primary"
        >
          <ChevronLeft class="size-5" stroke-width="2.5" />
        </button>

        <div
          role="tablist"
          aria-label="Elegir partido"
          class="grid flex-1 grid-cols-3 gap-2 sm:grid-cols-6"
        >
          {
            porPartido.map(({ partido }, i) => (
              <button
                type="button"
                data-party-tab={partido.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="inline-flex h-20 items-center justify-center rounded-xl px-3 text-xs font-black uppercase tracking-wide text-white transition-transform hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-offset-2 aria-pressed:ring-offset-background"
                style={`background-color:${partido.data.color};--tw-ring-color:${partido.data.color}`}
              >
                <img
                  src={partido.data.logo}
                  alt={partido.data.nombre}
                  width="80"
                  height="24"
                  loading="lazy"
                  class:list={[
                    'h-6 w-auto max-w-full object-contain brightness-0',
                    textoSobreColor(partido.data.color) === '#ffffff' ? 'invert' : '',
                  ]}
                />
              </button>
            ))
          }
        </div>

        <button
          type="button"
          data-party-next
          aria-label="Partido siguiente"
          class="inline-flex h-20 w-10 shrink-0 items-center justify-center rounded-xl border border-border bg-card text-foreground transition-colors hover:bg-muted hover:text-primary"
        >
          <ChevronRight class="size-5" stroke-width="2.5" />
        </button>
      </div>

      <p
        data-party-counter
        class="mb-6 text-center text-[11px] font-black uppercase tracking-widest text-muted-foreground"
      >
        1 / 6
      </p>

      <div data-party-slider class="relative">
        {
          porPartido.map(({ partido, animes: lista }, i) => {
            const punto = stats.get(partido.id)
            return (
              <section
                id={`partido-${partido.id}`}
                data-party-slide={partido.id}
                hidden={i !== 0}
                aria-label={partido.data.nombre}
                class="relative overflow-hidden rounded-2xl border bg-card scroll-mt-6"
                style={`border-color:${partido.data.color}`}
              >
                <p
                  class="pointer-events-none absolute -bottom-6 -right-2 z-0 select-none text-7xl font-black leading-none tracking-tighter sm:text-8xl"
                  style={`color:${partido.data.color};opacity:0.1`}
                  aria-hidden="true"
                >
                  {partido.data.nombre}
                </p>

                <div class="relative z-10 grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
                  <div class="border-b border-border p-6 lg:border-b-0 lg:border-r">
                    <div class="mb-5">
                      <img
                        src={partido.data.logo}
                        alt={partido.data.nombre}
                        width="240"
                        height="96"
                        loading="lazy"
                        class:list={[
                          'h-16 w-auto max-w-full object-contain sm:h-20',
                          partido.id === 'd21' ? 'dark:invert' : '',
                        ]}
                      />
                    </div>

                    <div class="mb-4">
                      <p class="text-2xl font-black tracking-tighter text-foreground">
                        {partido.data.siglas}
                      </p>
                      <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                        {partido.data.nombre} · {partido.data.ideologia}
                      </p>
                    </div>

                    <dl class="space-y-2 mb-4">
                      <div>
                        <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                          Promete
                        </dt>
                        <dd class="text-sm text-foreground">{partido.data.promesa}</dd>
                      </div>
                      <div>
                        <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                          Hace
                        </dt>
                        <dd class="text-sm text-foreground/80">{partido.data.contradiccion}</dd>
                      </div>
                    </dl>

                    <p
                      class="mb-5 border-l-2 pl-3 text-sm italic text-foreground/70"
                      style={`border-color:${partido.data.color}`}
                    >
                      «{partido.data.frase}»
                    </p>

                    <div class="mb-5 grid grid-cols-3 gap-2">
                      <div class="rounded-lg border border-border bg-muted/40 p-2">
                        <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                          Animes
                        </p>
                        <p class="text-lg font-black text-foreground">{lista.length}</p>
                      </div>
                      <div class="rounded-lg border border-border bg-muted/40 p-2">
                        <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                          Econ
                        </p>
                        <p class="text-lg font-black text-foreground">{punto?.eco.toFixed(1)}</p>
                      </div>
                      <div class="rounded-lg border border-border bg-muted/40 p-2">
                        <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                          Pers
                        </p>
                        <p class="text-lg font-black text-foreground">{punto?.pers.toFixed(1)}</p>
                      </div>
                    </div>

                    <NolanScatter puntos={puntos} activo={partido.id} class="w-full max-w-sm mx-auto" />

                    <a
                      href={`/partidos/${partido.id}`}
                      class="mt-4 inline-block text-[11px] font-black uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary"
                    >
                      Ver la ficha del partido →
                    </a>
                  </div>

                  <div class="p-4 sm:p-6">
                    <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                      Los {lista.length} animes de {partido.data.siglas}
                    </p>
                    <div class="grid grid-cols-3 gap-2 sm:gap-3">
                      {lista.map((anime) => (
                        <a
                          href={`/anime/${anime.data.slug}`}
                          class="group relative block overflow-hidden rounded-xl border border-border transition-transform hover:-translate-y-0.5"
                        >
                          <div class="relative aspect-3/4 bg-muted">
                            {anime.data.imagen && (
                              <img
                                src={anime.data.imagen}
                                alt={anime.data.titulo}
                                loading="lazy"
                                decoding="async"
                                class="absolute inset-0 h-full w-full object-cover"
                              />
                            )}
                            <div
                              class="pointer-events-none absolute inset-0 opacity-60 mix-blend-multiply"
                              style={`background-color:${partido.data.color}`}
                              aria-hidden="true"
                            />
                            <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-2">
                              <p class="text-[10px] font-bold leading-tight text-white line-clamp-2">
                                {anime.data.titulo}
                              </p>
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </section>
            )
          })
        }
      </div>

      <script>
        const tabs = Array.from(document.querySelectorAll('[data-party-tab]'))
        const slides = Array.from(document.querySelectorAll('[data-party-slide]'))
        const counter = document.querySelector('[data-party-counter]')
        const prev = document.querySelector('[data-party-prev]')
        const next = document.querySelector('[data-party-next]')
        let current = 0

        const show = (index) => {
          if (!slides.length) return
          current = (index + slides.length) % slides.length
          slides.forEach((slide, i) => {
            slide.hidden = i !== current
          })
          tabs.forEach((tab, i) => tab.setAttribute('aria-pressed', String(i === current)))
          if (counter) counter.textContent = `${current + 1} / ${slides.length}`
        }

        tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)))
        prev?.addEventListener('click', () => show(current - 1))
        next?.addEventListener('click', () => show(current + 1))

        document.addEventListener('keydown', (event) => {
          if (event.altKey || event.ctrlKey || event.metaKey) return
          const target = event.target
          if (target instanceof HTMLElement && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return
          if (event.key === 'ArrowLeft') show(current - 1)
          if (event.key === 'ArrowRight') show(current + 1)
        })
      </script>

      <p class="mt-10 text-center text-xs text-muted-foreground">
        Asignación satírica con motivo del 29N. Sin relación con los partidos ni con sus candidaturas.
      </p>
    </main>
  </div>
</Layout>
