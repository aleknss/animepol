---
import { getCollection } from 'astro:content'
import { ArrowLeft } from '@lucide/astro'
import Creditos from '@/components/Creditos.astro'
import Evento29N from '@/components/Evento29N.astro'
import NolanScatter from '@/components/NolanScatter.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import Layout from '@/layouts/Layout.astro'
import { partidosActivos, textoSobreColor } from '@/lib/utils'

const partidos = (await getCollection('partidos')).sort((a, b) => a.data.orden - b.data.orden)
const animes = await getCollection('animes')
const activo = partidosActivos()

const porPartido = partidos.map((partido) => ({
  partido,
  animes: animes
    .filter((anime) => anime.data.partido === partido.id)
    .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es')),
}))

const total = porPartido.reduce((sum, item) => sum + item.animes.length, 0)

const media = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length

const puntos = porPartido
  .filter((item) => item.animes.length > 0)
  .map((item) => ({
    slug: item.partido.id,
    siglas: item.partido.data.siglas,
    nombre: item.partido.data.nombre,
    color: item.partido.data.color,
    eco: Math.round(media(item.animes.map((anime) => anime.data.libertadEconomica)) * 10) / 10,
    pers: Math.round(media(item.animes.map((anime) => anime.data.libertadPersonal)) * 10) / 10,
    total: item.animes.length,
  }))
---

<Layout
  title="Partidos del 29N"
  description="Qué partido político le correspondería a cada anime según el diagrama de Nolan. Reparto satírico con motivo de las elecciones generales del 29 de noviembre."
>
  <div class="min-h-screen bg-background py-6 px-4">
    <header class="top-6 max-w-6xl w-full m-auto flex justify-between items-center">
      <Creditos />
      <ThemeToggle />
    </header>

    <main class="max-w-6xl mx-auto">
      <a
        href="/"
        class="text-muted-foreground hover:text-foreground mb-8 inline-flex items-center gap-1.5 transition-colors font-bold uppercase text-xs tracking-widest"
      >
        <ArrowLeft class="size-4" />
        Catálogo
      </a>

      <Evento29N subtitulo="Sátira electoral, no una encuesta" />

      <div class="mb-10 text-center">
        <h1 class="text-4xl md:text-5xl font-black text-primary tracking-tighter mb-3">
          ¿A quién votaría tu anime?
        </h1>
        <p class="text-foreground max-w-2xl mx-auto">
          {total} fichas repartidas entre seis partidos, con el mismo rigor que el resto del sitio:
          ninguno. Esto es una asignación satírica, no una encuesta ni una recomendación de voto.
        </p>
        {
          !activo && (
            <p class="mt-4 inline-block rounded-full border border-border px-3 py-1 text-xs font-bold uppercase tracking-widest text-muted-foreground">
              Evento finalizado
            </p>
          )
        }
      </div>

      <section class="mb-8 rounded-2xl border border-border bg-card p-6">
        <div class="mb-4 text-center">
          <h2 class="text-xl font-black text-foreground tracking-tighter">
            Dónde cae cada partido
          </h2>
          <p class="text-xs text-muted-foreground">
            Media de los ejes de sus animes. El eje vertical es libertad personal; el horizontal,
            económica.
          </p>
        </div>

        <NolanScatter puntos={puntos} class="w-full max-w-md mx-auto" />

        <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            puntos.map((punto) => (
              <li class="flex items-center gap-2 text-[11px]">
                <span
                  class="size-2.5 shrink-0 rounded-full"
                  style={`background-color:${punto.color}`}
                  aria-hidden="true"
                />
                <span class="font-black uppercase tracking-wide text-foreground">{punto.siglas}</span>
                <span class="text-muted-foreground">
                  Econ {punto.eco.toFixed(1)} · Pers {punto.pers.toFixed(1)}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mb-4 flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Filtrar partidos">
        <a
          href="/partidos/quiz"
          class="inline-flex h-8 items-center gap-1.5 rounded-full bg-primary px-3 text-[11px] font-black uppercase tracking-wide text-primary-foreground transition-transform hover:scale-105"
        >
          Jugar al quiz →
        </a>
        <span class="mx-1 h-4 w-px bg-border" aria-hidden="true"></span>
        <button
          type="button"
          data-party-tab="all"
          aria-pressed="true"
          class="inline-flex h-8 items-center rounded-full border border-border bg-muted px-3 text-[11px] font-black uppercase tracking-wide text-foreground transition-colors aria-pressed:bg-foreground aria-pressed:text-background"
        >
          Todos
        </button>
        {
          porPartido.map(({ partido }) => (
            <button
              type="button"
              data-party-tab={partido.id}
              aria-pressed="false"
              class="inline-flex h-8 items-center gap-1.5 rounded-full border px-3 text-[11px] font-black uppercase tracking-wide transition-colors"
              style={`border-color:${partido.data.color};color:${partido.data.color}`}
            >
              {partido.data.siglas}
            </button>
          ))
        }
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          porPartido.map(({ partido, animes: lista }) => (
            <section
              id={partido.id}
              data-party-card={partido.id}
              class="relative rounded-2xl border bg-card overflow-hidden scroll-mt-6"
              style={`border-color:${partido.data.color}`}
            >
              <span
                class="pointer-events-none absolute -right-3 -top-8 select-none text-[9rem] font-black leading-none opacity-10"
                style={`color:${partido.data.color}`}
                aria-hidden="true"
              >
                {partido.data.siglas}
              </span>

              <div
                class="relative flex items-center justify-between gap-3 px-5 py-4"
                style={`background-color:${partido.data.color};color:${textoSobreColor(partido.data.color)}`}
              >
                <div>
                  <a href={`/partidos/${partido.id}`} class="block hover:underline underline-offset-4">
                    <p class="text-2xl font-black tracking-tighter">{partido.data.siglas}</p>
                    <p class="text-[10px] font-bold uppercase tracking-widest opacity-80">
                      {partido.data.nombre}
                    </p>
                  </a>
                </div>
                <span class="rounded-full bg-black/10 px-2.5 py-1 text-xs font-black dark:bg-white/20">
                  {lista.length}
                </span>
              </div>

              <div class="relative p-5">
                <div class="flex items-center gap-3 mb-4">
                  <span class="flex h-10 w-16 shrink-0 items-center justify-center rounded-lg border border-border bg-white p-1.5">
                    <img
                      src={partido.data.logo}
                      alt={partido.data.nombre}
                      width="64"
                      height="40"
                      loading="lazy"
                      class="h-full w-full object-contain"
                    />
                  </span>
                  <p class="text-[10px] font-black uppercase tracking-tighter text-muted-foreground">
                    {partido.data.ideologia}
                  </p>
                </div>

                <dl class="space-y-2 mb-4">
                  <div>
                    <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                      Promete
                    </dt>
                    <dd class="text-sm text-foreground">{partido.data.promesa}</dd>
                  </div>
                  <div>
                    <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                      Hace
                    </dt>
                    <dd class="text-sm text-foreground/80">{partido.data.contradiccion}</dd>
                  </div>
                </dl>

                <p class="mb-4 border-l-2 pl-3 text-sm italic text-foreground/70" style={`border-color:${partido.data.color}`}>
                  «{partido.data.frase}»
                </p>

                <div class="flex items-end justify-between gap-3">
                  <div class="flex gap-1">
                    {lista.slice(0, 4).map((anime) => (
                      <span class="block h-14 w-10 overflow-hidden rounded-md bg-muted">
                        {anime.data.imagen && (
                          <img
                            src={anime.data.imagen}
                            alt={anime.data.titulo}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover"
                          />
                        )}
                      </span>
                    ))}
                  </div>
                  <a
                    href={`/partidos/${partido.id}`}
                    class="text-[11px] font-black uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary"
                  >
                    Ver los {lista.length} →
                  </a>
                </div>
              </div>
            </section>
          ))
        }
      </div>

      <script>
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-party-tab]'))
        const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-party-card]'))

        for (const tab of tabs) {
          tab.addEventListener('click', () => {
            const target = tab.dataset.partyTab ?? 'all'

            for (const card of cards) {
              card.hidden = target !== 'all' && card.dataset.partyCard !== target
            }

            for (const item of tabs) item.setAttribute('aria-pressed', String(item === tab))
          })
        }
      </script>

      <p class="mt-10 text-center text-xs text-muted-foreground">
        Asignación satírica con motivo del 29N. Sin relación con los partidos ni con sus candidaturas.
      </p>
    </main>
  </div>
</Layout>
