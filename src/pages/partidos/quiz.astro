---
import { getCollection } from 'astro:content'
import { ArrowLeft, Check, RotateCcw, Share2, X } from '@lucide/astro'
import Creditos from '@/components/Creditos.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import Layout from '@/layouts/Layout.astro'
import { partidosActivos, textoSobreColor } from '@/lib/utils'

const partidos = (await getCollection('partidos')).sort((a, b) => a.data.orden - b.data.orden)
const animes = (await getCollection('animes')).filter((anime) => anime.data.partido)

const partidosData = partidos.map((partido) => ({
  id: partido.id,
  siglas: partido.data.siglas,
  nombre: partido.data.nombre,
  color: partido.data.color,
  ink: textoSobreColor(partido.data.color),
}))

const animesData = animes.map((anime) => ({
  slug: anime.data.slug,
  titulo: anime.data.titulo,
  imagen: anime.data.imagen ?? '',
  partido: anime.data.partido,
  explicacion: anime.data.justificacionPartido ?? '',
}))

const activo = partidosActivos()
const TOTAL = 10

const conImagen = animes.filter((anime) => anime.data.imagen)
const abanico: typeof conImagen = []
for (const anime of conImagen) {
  if (abanico.length >= 3) break
  if (!abanico.some((item) => item.data.partido === anime.data.partido)) abanico.push(anime)
}

const colorDe = (id: string) => partidos.find((partido) => partido.id === id)?.data.color ?? '#000000'
---

<Layout
  title="¿De qué partido es? · 29N"
  description="Diez animes al azar: adivina a qué partido está asignado cada uno dentro del especial satírico del 29N."
>
  <div class="min-h-screen bg-background py-6 px-4">
    <header class="top-6 max-w-6xl w-full m-auto flex justify-between items-center">
      <Creditos />
      <ThemeToggle />
    </header>

    <main class="max-w-5xl mx-auto">
      <a
        href="/partidos"
        class="mt-4 mb-6 inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <ArrowLeft class="size-4" />
        Partidos 29N
      </a>

      {
        !activo ? (
          <p class="text-center text-sm text-muted-foreground">
            El quiz solo está disponible durante el evento.
          </p>
        ) : (
          <div id="quiz" class="text-center">
            <div id="quiz-start" class="relative flex min-h-[70vh] items-center">
              <p
                class="pointer-events-none absolute inset-0 flex select-none items-center justify-center text-[14rem] font-black leading-none tracking-tighter text-primary opacity-[0.06] sm:text-[20rem]"
                aria-hidden="true"
              >
                29N
              </p>

              <div class="relative grid w-full grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
                <div class="text-center lg:text-left">
                  <p class="text-[10px] font-black uppercase tracking-[0.35em] text-muted-foreground">
                    Especial 29N
                  </p>
                  <h1 class="mt-2 text-7xl font-black tracking-tighter text-primary sm:text-8xl md:text-9xl">
                    Quiz
                  </h1>
                  <p class="mx-auto mt-3 max-w-md text-sm text-muted-foreground lg:mx-0">
                    Diez animes al azar y tres opciones por pregunta. Acierta a qué partido los
                    asignó esta web.
                  </p>

                  <dl class="mx-auto mt-6 grid max-w-md grid-cols-3 gap-4 lg:mx-0">
                    <div>
                      <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                        Animes
                      </dt>
                      <dd class="text-2xl font-black text-foreground">{animes.length}</dd>
                    </div>
                    <div>
                      <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                        Partidos
                      </dt>
                      <dd class="text-2xl font-black text-foreground">{partidos.length}</dd>
                    </div>
                    <div>
                      <dt class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                        Preguntas
                      </dt>
                      <dd class="text-2xl font-black text-foreground">{TOTAL}</dd>
                    </div>
                  </dl>
                </div>

                <div class="flex flex-col items-center">
                  <div class="flex items-end justify-center gap-3">
                    {
                      abanico.map((anime, i) => (
                        <div
                          class="overflow-hidden rounded-lg bg-muted shadow-md transition-transform"
                          style={`transform: rotate(${(i - 1) * 6}deg) translateY(${Math.abs(i - 1) * 10}px)`}
                        >
                          <div class="h-48 w-32 sm:h-64 sm:w-44">
                            <img
                              src={anime.data.imagen}
                              alt={anime.data.titulo}
                              loading="lazy"
                              class="h-full w-full object-cover"
                            />
                          </div>
                          <div
                            class="h-1.5 w-full"
                            style={`background-color:${colorDe(anime.data.partido ?? '')}`}
                            aria-hidden="true"
                          ></div>
                        </div>
                      ))
                    }
                  </div>

                  <button
                    type="button"
                    id="quiz-go"
                    class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-black uppercase tracking-widest text-primary-foreground transition-transform hover:scale-105"
                  >
                    Empezar
                  </button>
                  <p id="quiz-best" class="mt-3 text-[11px] font-bold uppercase tracking-widest text-muted-foreground"></p>
                </div>
              </div>
            </div>

            <div id="quiz-game" hidden>
              <div class="mx-auto mb-2 flex max-w-md items-center justify-between text-[11px] font-black uppercase tracking-widest text-muted-foreground">
                <span id="quiz-progress">1 / 10</span>
                <span id="quiz-score">0 aciertos</span>
              </div>
              <div id="quiz-progress-bar" class="mx-auto mb-6 grid max-w-md grid-cols-10 gap-1"></div>

              <div
                id="quiz-stage"
                class="mx-auto grid max-w-md gap-8 lg:max-w-4xl lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:gap-10"
              >
                <div id="quiz-main">
                  <img
                    id="quiz-image"
                    src=""
                    alt=""
                    class="mx-auto mb-5 h-72 w-auto rounded-lg object-cover sm:h-80"
                  />
                  <p id="quiz-title" class="mb-1 text-2xl font-black tracking-tighter text-foreground"></p>
                  <p class="mb-5 text-xs font-bold uppercase tracking-widest text-muted-foreground">
                    ¿A qué partido está asignado?
                  </p>

                  <div id="quiz-options" class="mx-auto max-w-sm"></div>

                  <div class="mt-4 flex flex-wrap items-center justify-center gap-1 text-[10px] text-muted-foreground">
                    <span class="mr-1 font-bold uppercase tracking-widest">Atajos</span>
                    <kbd class="pointer-events-none inline-flex h-5 select-none items-center rounded border border-border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">1</kbd>
                    <kbd class="pointer-events-none inline-flex h-5 select-none items-center rounded border border-border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">2</kbd>
                    <kbd class="pointer-events-none inline-flex h-5 select-none items-center rounded border border-border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">3</kbd>
                    <span class="mx-1">·</span>
                    <kbd class="pointer-events-none inline-flex h-5 select-none items-center rounded border border-border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">Enter</kbd>
                  </div>

                  <p
                    id="quiz-feedback"
                    class="mt-4 flex items-center justify-center gap-1.5 text-sm text-muted-foreground"
                  >
                    <Check id="quiz-icon-ok" class="hidden size-4 text-green-600" aria-hidden="true" />
                    <X id="quiz-icon-x" class="hidden size-4 text-red-500" aria-hidden="true" />
                    <span id="quiz-feedback-text"></span>
                  </p>
                </div>

                <aside
                  id="quiz-answer"
                  class="mx-auto mt-6 max-w-sm text-left text-sm leading-relaxed text-muted-foreground lg:mx-0 lg:mt-0 lg:max-w-none lg:border-l lg:border-border lg:pl-10"
                >
                  <p id="quiz-explanation">
                    Elige una opción y aquí aparece la explicación de la asignación.
                  </p>

                  <button
                    type="button"
                    id="quiz-next"
                    hidden
                    class="mt-6 text-sm font-black uppercase tracking-widest text-primary underline-offset-4 hover:underline"
                  >
                    Siguiente →
                  </button>
                </aside>
              </div>
            </div>

            <div id="quiz-end" hidden class="relative py-8">
              <p
                class="pointer-events-none absolute inset-0 flex select-none items-center justify-center text-[12rem] font-black leading-none tracking-tighter text-primary opacity-[0.05] sm:text-[18rem]"
                aria-hidden="true"
              >
                29N
              </p>

              <p class="relative text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-1">
                Resultado
              </p>
              <p id="quiz-final" class="relative text-7xl font-black tracking-tighter text-primary mb-2 sm:text-8xl"></p>
              <p id="quiz-verdict" class="relative mx-auto max-w-sm text-sm text-foreground mb-2"></p>
              <p id="quiz-best-end" class="relative text-[11px] font-bold uppercase tracking-widest text-muted-foreground"></p>

              <div id="quiz-results" class="relative mx-auto mt-8 grid max-w-2xl gap-6 text-left sm:grid-cols-2">
                <div>
                  <h3 class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                    Acertados
                  </h3>
                  <ul id="quiz-ok-list" class="mt-2 space-y-1.5"></ul>
                </div>
                <div>
                  <h3 class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                    Fallados
                  </h3>
                  <ul id="quiz-ko-list" class="mt-2 space-y-1.5"></ul>
                </div>
              </div>
              <div class="relative mt-8 flex flex-wrap items-center justify-center gap-2">
                <button
                  type="button"
                  id="quiz-restart"
                  class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2 text-xs font-black uppercase tracking-widest text-foreground transition-colors hover:bg-muted"
                >
                  <RotateCcw class="size-4" />
                  Otra ronda
                </button>
                <button
                  type="button"
                  id="quiz-share"
                  class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-black uppercase tracking-widest text-primary-foreground transition-transform hover:scale-105"
                >
                  <Share2 class="size-4" />
                  Compartir
                </button>
                <a
                  href="/partidos"
                  class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2 text-xs font-black uppercase tracking-widest text-foreground transition-colors hover:bg-muted"
                >
                  Ver el reparto
                </a>
              </div>
              <p id="quiz-share-status" class="mt-3 text-[11px] text-muted-foreground"></p>
            </div>
          </div>
        )
      }

      <script is:inline type="application/json" id="quiz-data" set:html={JSON.stringify({ partidos: partidosData, animes: animesData })} />

      <p class="mt-10 text-center text-xs text-muted-foreground">
        Asignación satírica con motivo del 29N. Sin relación con los partidos ni con sus candidaturas.
      </p>
    </main>
  </div>
</Layout>

<script>
  type Partido = {
    id: string
    siglas: string
    nombre: string
    color: string
    ink: string
  }

  type Anime = {
    slug: string
    titulo: string
    imagen: string
    partido: string
    explicacion: string
  }

  type QuizData = {
    partidos: Partido[]
    animes: Anime[]
  }

  type Resultado = {
    ok: boolean
    color: string
    titulo: string
    partido: string
  }

  const parse = <T,>(id: string): T | null => {
    const el = document.getElementById(id)
    if (!el?.textContent) return null
    try {
      return JSON.parse(el.textContent)
    } catch {
      return null
    }
  }

  const data = parse<QuizData>('quiz-data')
  const start = document.getElementById('quiz-start')
  const game = document.getElementById('quiz-game')
  const end = document.getElementById('quiz-end')

  if (data && start && game && end) {
    const TOTAL = 10
    const options = document.getElementById('quiz-options')
    const image = document.getElementById('quiz-image') as HTMLImageElement | null
    const title = document.getElementById('quiz-title')
    const progress = document.getElementById('quiz-progress')
    const scoreEl = document.getElementById('quiz-score')
    const feedback = document.getElementById('quiz-feedback')
    const feedbackText = document.getElementById('quiz-feedback-text')
    const iconOk = document.getElementById('quiz-icon-ok')
    const iconX = document.getElementById('quiz-icon-x')
    const explanation = document.getElementById('quiz-explanation')
    const stage = document.getElementById('quiz-stage')
    const next = document.getElementById('quiz-next')
    const final = document.getElementById('quiz-final')
    const verdict = document.getElementById('quiz-verdict')
    const bestEl = document.getElementById('quiz-best')
    const bestEnd = document.getElementById('quiz-best-end')
    const share = document.getElementById('quiz-share')
    const shareStatus = document.getElementById('quiz-share-status')
    const BEST_KEY = 'animepol-quiz-best'

    const readBest = () => {
      try {
        const value = Number(localStorage.getItem(BEST_KEY))
        return Number.isFinite(value) ? value : 0
      } catch {
        return 0
      }
    }

    const renderBest = () => {
      const best = readBest()
      const text = best > 0 ? `Récord: ${best} / ${TOTAL}` : 'Sin récord todavía'
      if (bestEl) bestEl.textContent = text
      if (bestEnd) bestEnd.textContent = text
    }

    let queue: Anime[] = []
    let index = 0
    let score = 0
    let answered = false
    let resultados: Array<Resultado | undefined> = []

    const bar = document.getElementById('quiz-progress-bar')

    const pintarProgreso = () => {
      if (!bar) return

      if (bar.children.length !== TOTAL) {
        bar.innerHTML = ''
        for (let i = 0; i < TOTAL; i++) {
          const segmento = document.createElement('span')
          segmento.className = 'h-2 rounded-full bg-muted'
          bar.appendChild(segmento)
        }
      }

      for (let i = 0; i < TOTAL; i++) {
        const segmento = bar.children[i]
        if (!(segmento instanceof HTMLElement)) continue

        const resultado = resultados[i]
        segmento.style.backgroundColor = resultado ? resultado.color : ''
        segmento.style.opacity = resultado && !resultado.ok ? '0.35' : '1'
        segmento.title = resultado
          ? resultado.ok
            ? 'Acierto'
            : 'Fallo'
          : `Pregunta ${i + 1}`
      }
    }

    const shuffle = <T,>(items: T[]): T[] => {
      const copy = [...items]
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1))
        ;[copy[i], copy[j]] = [copy[j], copy[i]]
      }
      return copy
    }

    const listaPartidos = data.partidos
    const siglas = new Map<string, Partido>(
      listaPartidos.map((partido): [string, Partido] => [partido.id, partido]),
    )

    function render() {
      const anime = queue[index]
      const correct = siglas.get(anime.partido)
      if (!correct || !options || !image || !title || !progress || !scoreEl || !feedback || !next) return

      answered = false
      next.hidden = true
      if (feedbackText) feedbackText.textContent = ''
      iconOk?.classList.add('hidden')
      iconX?.classList.add('hidden')
      stage?.classList.remove('is-answered')
      if (explanation) {
        explanation.textContent = 'Elige una opción y aquí aparece la explicación de la asignación.'
      }
      progress.textContent = `${index + 1} / ${TOTAL}`
      scoreEl.textContent = `${score} acierto${score === 1 ? '' : 's'}`
      title.textContent = anime.titulo

      if (anime.imagen) {
        image.src = anime.imagen
        image.alt = anime.titulo
        image.hidden = false
      } else {
        image.hidden = true
      }

      const wrong = shuffle(listaPartidos.filter((partido) => partido.id !== anime.partido)).slice(0, 2)
      const opts = shuffle([correct, ...wrong])

      options.innerHTML = ''
      for (const partido of opts) {
        const button = document.createElement('button')
        button.type = 'button'
        button.textContent = partido.nombre
        button.className =
          'flex w-full items-center gap-2 border-b border-border px-2 py-3 text-left text-sm font-bold uppercase tracking-wide text-foreground transition-colors hover:bg-muted hover:text-primary disabled:hover:bg-transparent disabled:hover:text-foreground'
        button.style.borderColor = partido.color

        const dot = document.createElement('span')
        dot.className = 'size-2.5 shrink-0 rounded-full'
        dot.style.backgroundColor = partido.color
        dot.setAttribute('aria-hidden', 'true')
        button.prepend(dot)

        button.addEventListener('click', () => {
          if (answered) return
          answered = true

          const right = partido.id === anime.partido
          if (right) score++

          for (const other of options.querySelectorAll('button')) {
            other.disabled = true
            if (other === button) continue
            if (other.textContent?.trim() === correct.nombre) {
              other.style.backgroundColor = correct.color
              other.style.color = correct.ink
              other.style.borderColor = correct.color
            } else {
              other.style.opacity = '0.45'
            }
          }

          if (!right) button.style.opacity = '0.45'

          if (feedbackText) {
            feedbackText.textContent = right
              ? `Correcto. ${correct.nombre}.`
              : `No. Era ${correct.nombre}.`
          }
          iconOk?.classList.toggle('hidden', !right)
          iconX?.classList.toggle('hidden', right)

          resultados[index] = {
            ok: right,
            color: correct.color,
            titulo: anime.titulo,
            partido: correct.siglas,
          }
          pintarProgreso()

          if (explanation) {
            explanation.innerHTML = ''
            const cabecera = document.createElement('p')
            cabecera.className = 'mb-2 text-[10px] font-black uppercase tracking-widest'
            cabecera.style.color = correct.color
            cabecera.textContent = `${correct.nombre} · ${anime.titulo}`
            const texto = document.createElement('p')
            texto.textContent = anime.explicacion || 'Sin justificación guardada para esta ficha.'
            explanation.append(cabecera, texto)
          }

          stage?.classList.add('is-answered')
          next.hidden = false
          scoreEl.textContent = `${score} acierto${score === 1 ? '' : 's'}`
        })
        options.appendChild(button)
      }
    }

    function finish() {
      if (!start || !game || !end || !final || !verdict) return
      start.hidden = true
      game.hidden = true
      end.hidden = false

      const previous = readBest()
      if (score > previous) {
        try {
          localStorage.setItem(BEST_KEY, String(score))
        } catch {}
      }
      renderBest()
      if (shareStatus) shareStatus.textContent = ''

      final.textContent = `${score} / ${TOTAL}`
      const record = score > previous ? ' Nuevo récord.' : ''
      const mensaje =
        score >= 9
          ? 'Trabajas en la web o tienes demasiado tiempo libre.'
          : score >= 6
            ? 'Has interiorizado el reparto. Preocupante, pero útil.'
            : score >= 3
              ? 'Nivel medio: sabes que el PP no es Podemos y poco más.'
              : 'Suspenso electoral. Vuelve al catálogo.'
      verdict.textContent = mensaje + record

      const okList = document.getElementById('quiz-ok-list')
      const koList = document.getElementById('quiz-ko-list')

      const pintarLista = (lista: HTMLElement | null, items: Resultado[]) => {
        if (!lista) return
        lista.innerHTML = ''
        if (items.length === 0) {
          const vacio = document.createElement('li')
          vacio.className = 'text-xs text-muted-foreground'
          vacio.textContent = 'Ninguno.'
          lista.appendChild(vacio)
          return
        }
        for (const item of items) {
          const fila = document.createElement('li')
          fila.className = 'flex items-center gap-2 text-xs text-foreground'
          const punto = document.createElement('span')
          punto.className = 'size-2 shrink-0 rounded-full'
          punto.style.backgroundColor = item.color
          const texto = document.createElement('span')
          texto.textContent = `${item.titulo} · ${item.partido}`
          fila.append(punto, texto)
          lista.appendChild(fila)
        }
      }

      pintarLista(
        okList,
        resultados.filter((item): item is Resultado => Boolean(item?.ok)),
      )
      pintarLista(
        koList,
        resultados.filter((item): item is Resultado => Boolean(item && !item.ok)),
      )
    }

    const startParam = new URLSearchParams(location.search).get('start')

    const begin = () => {
      queue = shuffle(data.animes)
      if (startParam) {
        const first = queue.findIndex((anime) => anime.slug === startParam)
        if (first > 0) queue.unshift(queue.splice(first, 1)[0])
      }
      queue = queue.slice(0, TOTAL)
      index = 0
      score = 0
      resultados = []
      pintarProgreso()
      if (!start || !game || !end) return
      start.hidden = true
      game.hidden = false
      end.hidden = true
      render()
    }

    document.getElementById('quiz-go')?.addEventListener('click', begin)

    if (startParam) begin()

    next?.addEventListener('click', () => {
      index++
      if (index >= TOTAL) finish()
      else render()
    })

    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      if (!start || !game || !end) return
      start.hidden = false
      game.hidden = true
      end.hidden = true
      renderBest()
    })

    share?.addEventListener('click', async () => {
      const text = `He sacado ${score}/${TOTAL} en el quiz de partidos de Animepol. ¿Y tú?`
      const url = `${location.origin}/partidos/quiz`

      try {
        if (navigator.share) {
          await navigator.share({ title: 'Quiz Animepol 29N', text, url })
          return
        }

        await navigator.clipboard.writeText(`${text} ${url}`)
        if (shareStatus) shareStatus.textContent = 'Resultado copiado al portapapeles.'
      } catch {
        if (shareStatus) shareStatus.textContent = 'No se pudo compartir.'
      }
    })

    document.addEventListener('keydown', (event) => {
      if (!game || game.hidden) return

      const target = event.target
      if (
        target instanceof HTMLElement &&
        ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
      ) {
        return
      }

      if (event.key === 'Enter' && next && !next.hidden) {
        event.preventDefault()
        next.click()
        return
      }

      if (!answered && options && ['1', '2', '3'].includes(event.key)) {
        const button = options.children[Number(event.key) - 1]
        if (button instanceof HTMLElement) {
          event.preventDefault()
          button.click()
        }
      }
    })

    renderBest()
    pintarProgreso()
  }
</script>

<style>
  #quiz-answer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 0.4s ease,
      max-height 0.5s ease;
  }

  #quiz-main {
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #quiz-stage.is-answered #quiz-answer {
    max-height: 40rem;
    opacity: 1;
  }

  @media (min-width: 1024px) {
    #quiz-main {
      transform: translateX(11rem);
    }

    #quiz-answer {
      max-height: none;
      overflow: visible;
    }

